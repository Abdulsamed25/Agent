from flask import blueprint , request , jsonify

youtube_bp = blueprint(
      " youtube ",
       __name__
  )

@youtube-bp.route(
       "/play",
methods =["POST"]

)
def play ():
    data = request.get__json(
       silent = true
        )or{}

command = data.get(
    "command",
    ""
).strip()

if not command :
   return jsonify({
     "success" = "false",
     "message":"there no song name , mentioned "
})400
